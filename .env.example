# Dedicated burner wallet for Ethereum Sepolia only. Never use a wallet that holds real funds.
# Create one with: npm run wallet
TELEGRAPH_EVM_PRIVATE_KEY=
# Optional separate key for signing memos. Falls back to the burner wallet.
MEMO_SIGNER_PRIVATE_KEY=

TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Safety limits in atomic USDC (1000000 = 1 USDC). These are not protocol prices.
MAX_ASSESSMENT_ATOMIC=70000
MAX_REQUEST_ATOMIC=20000
# Lifetime cap across stored assessments, so a shared deployment cannot drain the wallet.
MAX_TOTAL_ATOMIC=5000000
# Total for one batch run.
MAX_BATCH_ATOMIC=700000
MAX_CHECKS=6
MAX_REQUESTS=7
REQUEST_CONCURRENCY=3
REQUEST_TIMEOUT_MS=120000

# Optional. When set, requests from the browser extension must send this as a bearer key.
ASSESS_API_KEY=
